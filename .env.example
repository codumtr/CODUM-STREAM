# ========================================================
# CODUM.TR STREAM - Canlı Dublaj Yapay Zekâ Konfigürasyonu
# ========================================================
# Bu dosyayı '.env' olarak kopyalayın ve anahtarlarınızı girin.
# Not: Boş bıraksanız dahi sistem Edge-TTS ve yerel motorlarla çalışır.

# 1. Konuşma Tanıma (STT) & Hızlı Çeviri (LLM) - LPU Hızında (~120ms)
# https://console.groq.com/
GROQ_API_KEY=

# 2. Alternatif Çeviri Motoru (Google Gemini 2.0 Flash)
# https://aistudio.google.com/
GEMINI_API_KEY=

# 3. Yayıncı Ses Klonlama Motoru (ElevenLabs veya Cartesia)
# https://elevenlabs.io/
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# 4. Güvenlik & Yayıncı Tokeni
STREAM_TOKEN=codum_live_key
HOST=127.0.0.1
PORT=8765
